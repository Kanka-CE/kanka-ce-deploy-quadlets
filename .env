# ------------------------------------------------------------------
# Kanka Community Edition
# ------------------------------------------------------------------
#
# Notes
# - Keep secrets out of version control; use podman secrets instead.
# - For production: set APP_ENV=production, enable HTTPS, and use robust credentials.
# ------------------------------------------------------------------


# -------------------------
# Application settings
# -------------------------
APP_NAME="Kanka Community Edition"


# Public URL where Kanka is reachable and contact information.
APP_URL=http://localhost
APP_EMAIL=kanka@your-domain.com
# Important: 
# If you configured KankaCE to send emails, you need to enable the email here!
# This flag is set to false by default to avoid the application crashing
# when there is no email configured.
APP_EMAIL_ENABLED=false

# Allow users to self-register. Set to "false" to disable public signups.
APP_REGISTRATION_ENABLED=true

# Require an invitation to register. 
# When true, users need the invitation password set here.
APP_INVITATION_REQUIRED=false
APP_INVITATION_PASSWORD=

# App environment. 
#   - Use "local" only for the set-up process and testing.
#   - Use "local" only for the setup process and testing.
#   - Use "production" for live systems.
# Important: 
# For the first-time setup, this value has to be set to `local`.
# After the installation is finished, you are free to set this value 
# to `production` and restart the container to apply the changes.
APP_ENV=local

FRONT_DOMAIN="${APP_URL}"
APP_DOMAIN="${APP_URL}"
API_DOMAIN="${APP_URL}"

# Timezone
TZ=Etc/UTC


# -------------------------
# Mail
# -------------------------
# If you'd like for Kanka-CE to send emails, e.g. for password recovery, 
# you need to connect to an existing mail server, as Kanka-CE does not come
# with a built-in mail server.
# However, Kanka-CE will work fine, even without a mail server connection.

# You only need to change these if you want to use something other
# than an SMTP server. In most cases, you can leave these unchanged.
#Environment=MAIL_DRIVER=smtp
#Environment=MAIL_MAILER=smtp
#Environment=MAIL_ENCRYPTION=tls

# Connect to your SMTP server by providing the URL, Port, 
# a (Kanka-CE-) user and the password for the (Kanka-CE-) user.

# If you set a MAIL_PASSWORD, remember to move that into podman secrets
# and keep your password out of version control.
MAIL_HOST=mail.your-domain.com
MAIL_PORT=465
MAIL_USERNAME=kanka-ce@your-domain.com
MAIL_PASSWORD=password

# Sender Information
MAIL_FROM_ADDRESS="${APP_EMAIL}"
MAIL_FROM_NAME="${APP_NAME}"

